{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oclive.dev/schemas/spirit/sensor-observation.v0.1.schema.json",
  "title": "OCLive Spirit SensorObservation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "device_id",
    "node_id",
    "observation_type",
    "timestamp_ms",
    "sequence",
    "confidence",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "observation_type": {
      "enum": [
        "grip.engaged",
        "grip.released",
        "shoulder.engaged",
        "shoulder.released",
        "motion.moving",
        "motion.raised",
        "motion.lowered",
        "motion.idle",
        "trigger.test",
        "impact.estimated",
        "node.status"
      ]
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "observation_type": {
            "const": "node.status"
          }
        },
        "required": [
          "observation_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "required": [
              "power_source",
              "battery_state"
            ],
            "properties": {
              "power_source": {
                "enum": [
                  "bench",
                  "cr2032",
                  "cr1632",
                  "other"
                ]
              },
              "battery_mv": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5000
              },
              "battery_state": {
                "enum": [
                  "normal",
                  "low",
                  "critical",
                  "unknown",
                  "not_applicable"
                ]
              },
              "firmware_version": {
                "type": "string",
                "maxLength": 64
              },
              "calibration_version": {
                "type": "string",
                "maxLength": 64
              }
            },
            "additionalProperties": true
          }
        }
      }
    }
  ]
}
