{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oclive.dev/schemas/spirit/sensor-observation.v0.1.schema.json",
  "title": "OCLive Spirit SensorObservation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "device_id",
    "node_id",
    "observation_type",
    "timestamp_ms",
    "sequence",
    "confidence",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observation_id": {
      "type": "string",
      "format": "uuid"
    },
    "device_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "observation_type": {
      "enum": [
        "grip.engaged",
        "grip.released",
        "shoulder.engaged",
        "shoulder.released",
        "motion.raised",
        "motion.lowered",
        "motion.idle",
        "dock.entered",
        "dock.exited",
        "trigger.test",
        "impact.estimated",
        "node.status"
      ]
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "payload": {
      "type": "object"
    }
  }
}
