{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oclive.dev/schemas/spirit/output-cue.v0.1.schema.json",
  "title": "OCLive Spirit Visual OutputCue v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cue_id",
    "cue_type",
    "priority",
    "ttl_ms",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "cue_id": {
      "type": "string",
      "format": "uuid"
    },
    "cue_type": {
      "const": "visual"
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "ttl_ms": {
      "type": "integer",
      "minimum": 0
    },
    "payload": {
      "$ref": "#/$defs/visualPayload"
    }
  },
  "$defs": {
    "visualPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual_state_id"
      ],
      "properties": {
        "visual_state_id": {
          "type": "string",
          "minLength": 1
        },
        "hud_state": {
          "type": "object"
        }
      }
    }
  }
}
